  "tour_welcome_title": "👋 Welcome to English Autentico!",
  "tour_welcome_desc": "This 13-step tour shows you the main features. It takes less than 2 minutes — let's go!",
  "tour_stats_title": "🏅 Level, XP & Streak",
  "tour_stats_desc": "Every activity earns XP. Accumulate enough and your level rises, unlocking new temples. Keep your 🔥 streak alive by studying every day!",
  "tour_templi_title": "🏛️ Temples — Your Vocabulary Packs",
  "tour_templi_desc": "Each temple is a set of ~20 words from an English-speaking city. Start with Temple 1 (New York). New temples unlock as your level grows.",
  "tour_goal_title": "🎯 Set a Goal with a Deadline",
  "tour_goal_desc": "Pick a target level and a deadline date. The app calculates how many XP per day you need and shows your daily progress bar at the top.",
  "tour_flashcard_title": "🃏 Smart Flashcards (FSRS)",
  "tour_flashcard_desc": "Select a temple and study its words with Spaced Repetition. The FSRS-4.5 algorithm schedules each word so you review it just before you would forget it.",
  "tour_modes_title": "🔄 Four Study Modes",
  "tour_modes_desc": "Normal (EN→PT) · Reverse (PT→EN) · Context (fill the gap) · Listen (guess from audio). Switch modes to build all-round mastery!",
  "tour_rate_title": "⭐ Rate Every Card Honestly",
  "tour_rate_desc": "Again = tomorrow · Hard = 1 day · Good = 3 days · Easy = 2 weeks. The algorithm adjusts future intervals based on your answer — honesty beats the system!",
  "tour_quiz_title": "❓ Quiz — 4 Exercise Types",
  "tour_quiz_desc": "Vocabulary, Grammar, Listening and Spelling. Complete a quiz to unlock the next temple and earn bonus XP!",
  "tour_grammatica_title": "📚 Grammar — A1 to B2",
  "tour_grammatica_desc": "90 lessons from beginner to upper-intermediate. Each lesson has theory cards, examples, common traps and exercises — all in English.",
  "tour_vocabolario_title": "📖 Vocabulary — Self-Test Mode",
  "tour_vocabolario_desc": "Tap 'Hide EN' or 'Hide PT' to cover a column and test yourself. Filter by temple or category and click any word to hear it.",
  "tour_reading_title": "📜 Reading — Authentic Texts",
  "tour_reading_desc": "Real English stories at A1–B2 level. Tap any word to see its translation. Use Immersion Mode to hide the Portuguese and challenge yourself!",
  "tour_dialoghi_title": "💬 Dialogues — Real Conversations",
  "tour_dialoghi_desc": "Practise everyday English scenarios: coffee shops, airports, job interviews. Listen, read and respond — or import your own via the 🤖 AI button!",
  "tour_canzoni_title": "🎵 Songs — Learn with Music",
  "tour_canzoni_desc": "Follow English song lyrics and fill in the missing words. Add any song with the 🤖 AI Import button. Music makes vocabulary stick!",
  "tour_config_title": "⚙️ Settings & Profile",
  "tour_config_desc": "Switch to dark mode, mute sounds and access Profile options at the top of the screen.",
